<%= render "shared/navbar" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <!-- User Information -->
  <div class="bg-white shadow-md rounded-lg p-6 space-y-2 text-gray-800">
    <h2 class="text-2xl font-bold">Your Info</h2>
    <p><strong>First Name:</strong> <%= @user.first_name %></p>
    <p><strong>Last Name:</strong> <%= @user.last_name %></p>
    <p><strong>Email:</strong> <%= @user.email %></p>
  </div>

  <% if @all_bookings.empty? %>
    <!-- No Bookings -->
    <div class="bg-white shadow-md rounded-lg p-6 flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0 md:space-x-6 hover:shadow-xl transition">
      <div class="flex items-center space-x-4">
        <h2 class="text-lg font-semibold text-gray-700">Looks like you have no bookings!</h2>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
        </svg>
      </div>

      <%= link_to "Book your next adventure here", root_path, class: "inline-block text-white bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded-md text-sm font-semibold transition" %>
    </div>

  <% else %>
    <!-- Bookings List -->
    <div class="space-y-6">
      <% @bookings.each do |booking| %>
        <div class="bg-white shadow-md rounded-lg p-6 flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-6 hover:shadow-xl transition">

          <!-- Airline Logo -->
          <div class="flex-shrink-0">
            <img class="h-24 w-48 object-cover rounded" src="<%= booking.flight.airline.logo %>" alt="Airline Logo">
          </div>

          <!-- Flight Info -->
          <div class="flex-1 text-gray-800 space-y-1">
            <p class="text-lg font-semibold"><%= booking.flight.airline.name %> — <%= booking.flight.flight_number %></p>
            <p><strong>From:</strong> <%= booking.flight.origin %></p>
            <p><strong>Departure:</strong> <%= booking.flight.departure.strftime("%b %d, %Y %I:%M %p") %></p>
            <p><strong>To:</strong> <%= booking.flight.destination %></p>
            <p><strong>Arrival:</strong> <%= booking.flight.arrival.strftime("%b %d, %Y %I:%M %p") %></p>
          </div>

          <!-- Booking Price + Link -->
          <div class="text-right space-y-2">
            <p class="text-green-600 font-bold text-lg">Price: $<%= booking.flight.price %></p>
            <%= link_to "More Info", booking_path(booking), class: "inline-block bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium px-4 py-2 rounded-md transition" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
