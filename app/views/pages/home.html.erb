
<%= render "shared/navbar" %>

<div class="min-h-screen bg-gradient-to-b from-purple-50 via-white to-purple-50">

  <!-- Hero Section with Search Form -->
  <div class="pt-12 pb-16 px-6">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-5xl font-bold text-purple-700 mb-3">Find Your Perfect Flight</h1>
        <p class="text-gray-600 text-lg">Search and compare flights from top airlines</p>
      </div>

      <!-- Search Form Card -->
      <div class="bg-white shadow-2xl rounded-2xl p-8 border border-purple-100">
        <%= simple_form_for "", url: search_flights_path, method: :get, html: { class: "space-y-6" } do |f| %>

          <!-- Origin and Destination Row -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.input :origin,
                  placeholder: "Departure City",
                  input_html: {
                    value: params[:origin],
                    class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition"
                  },
                  label_html: { class: "text-gray-700 font-semibold mb-2 block" } %>
            </div>
            <div>
              <%= f.input :destination,
                  placeholder: "Arrival City",
                  input_html: {
                    value: params[:destination],
                    class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition"
                  },
                  label_html: { class: "text-gray-700 font-semibold mb-2 block" } %>
            </div>
          </div>

          <!-- Departure Date and Round Trip Row -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
            <div class="md:col-span-2">
              <%= f.input :departure,
                  as: :date,
                  html5: true,
                  input_html: {
                    value: params[:departure],
                    class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition"
                  },
                  label_html: { class: "text-gray-700 font-semibold mb-2 block" } %>
            </div>
            <div class="flex items-center h-full pb-2">
              <%= f.input :round_trip,
                  as: :boolean,
                  label: "Round trip",
                  input_html: { class: "w-5 h-5 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" },
                  label_html: { class: "text-gray-700 font-semibold ml-2" } %>
            </div>
          </div>

          <!-- Return Date Field (Hidden by default) -->
          <div id="return-date-field" class="hidden">
            <%# <%= f.input :return_date, as: :date, html5: true, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" }, label_html: { class: "text-gray-700 font-semibold mb-2 block" } %>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <%= f.button :submit, "Search Flights", class: "w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white py-4 px-6 rounded-lg hover:from-purple-700 hover:to-purple-800 transition duration-300 font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
          </div>

        <% end %>
      </div>
    </div>
  </div>

  <!-- Airlines Section -->
  <div class="py-16 px-6 bg-white">
    <div class="max-w-6xl mx-auto">

      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-purple-700 mb-3">Our Partner Airlines</h2>
        <p class="text-gray-600 text-lg">Choose from the world's leading carriers</p>
      </div>

      <!-- Airline Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @airlines.each do |airline| %>
          <div class="group bg-white border-2 border-purple-100 hover:border-purple-300 shadow-md hover:shadow-2xl transition-all duration-300 rounded-xl p-6 transform hover:-translate-y-1">

            <!-- Airline Logo -->
            <div class="mb-4 flex items-center justify-center bg-purple-50 rounded-lg p-4 h-32">
              <img class="max-h-20 max-w-full object-contain" src="<%= airline.logo %>" alt="<%= airline.name %> Logo">
            </div>

            <!-- Airline Name -->
            <div class="text-center">
              <h3 class="text-xl font-bold text-gray-800 group-hover:text-purple-700 transition"><%= airline.name %></h3>
            </div>

            <!-- Decorative Element -->
            <div class="mt-4 h-1 w-16 bg-gradient-to-r from-purple-400 to-purple-600 mx-auto rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Optional: Features Section -->
  <div class="py-16 px-6 bg-gradient-to-b from-purple-50 to-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-full mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-2">Easy Search</h3>
          <p class="text-gray-600">Find flights quickly with our intuitive search interface</p>
        </div>

        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-full mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-2">Best Prices</h3>
          <p class="text-gray-600">Compare prices across multiple airlines instantly</p>
        </div>

        <div class="text-center p-6">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-full mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-2">Secure Booking</h3>
          <p class="text-gray-600">Book with confidence using our secure platform</p>
        </div>

      </div>
    </div>
  </div>

</div>
