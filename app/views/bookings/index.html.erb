<%= render "shared/navbar" %>

<div class="w-full max-w-2xl mx-auto px-4 py-4 space-y-6">
  <% @bookings.each do |booking| %>

    <div class="bg-gradient-to-br from-white to-purple-50 shadow-md rounded-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-purple-100">

      <!-- Airline Header -->
      <div class="bg-purple-700 text-white px-6 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <div>
            <p class="font-bold text-lg"><%= booking.flight.airline.name %></p>
            <p class="text-sm text-purple-200">Flight <%= booking.flight.flight_number %></p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-2xl font-bold">$<%= booking.flight.price %></p>
        </div>
      </div>

      <!-- Airline Logo -->
      <div class="p-6 space-y-4">
        <div class="flex justify-center bg-white p-4 rounded-lg border border-purple-100">
          <img class="h-20 w-auto object-contain" src="<%= booking.flight.airline.logo %>" alt="<%= booking.flight.airline.name %> Logo">
        </div>

        <!-- Route -->
        <div class="flex items-center justify-between bg-gradient-to-r from-purple-100 to-purple-50 p-6 rounded-lg">
          <div class="text-center flex-1">
            <p class="text-3xl font-bold text-purple-700"><%= booking.flight.origin %></p>
            <p class="text-xs text-gray-600 mt-1 uppercase tracking-wide">Origin</p>
          </div>
          <div class="mx-4">
            <svg class="w-10 h-10 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>
          </div>
          <div class="text-center flex-1">
            <p class="text-3xl font-bold text-purple-700"><%= booking.flight.destination %></p>
            <p class="text-xs text-gray-600 mt-1 uppercase tracking-wide">Destination</p>
          </div>
        </div>

        <!-- Departure & Arrival Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-lg border border-purple-100">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 flex items-center">
              <svg class="h-4 w-4 mr-1 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              Departure
            </p>
            <p class="text-lg font-bold text-gray-800"><%= booking.flight.origin %></p>
            <p class="text-2xl font-bold text-purple-700"><%= booking.flight.departure.strftime("%l:%M %p") %></p>
            <p class="text-sm text-gray-600"><%= booking.flight.departure.strftime("%A, %B %d, %Y") %></p>
          </div>

          <div class="bg-white p-4 rounded-lg border border-purple-100">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 flex items-center">
              <svg class="h-4 w-4 mr-1 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
              Arrival
            </p>
            <p class="text-lg font-bold text-gray-800"><%= booking.flight.destination %></p>
            <p class="text-2xl font-bold text-purple-700"><%= booking.flight.arrival.strftime("%l:%M %p") %></p>
            <p class="text-sm text-gray-600"><%= booking.flight.arrival.strftime("%A, %B %d, %Y") %></p>
          </div>
        </div>
      </div>
       <!-- Action Buttons -->
                    <div class="flex gap-3 pt-2 p-6">
                      <%= link_to flight_path(booking.flight), class: "flex-1 inline-flex items-center justify-center bg-white hover:bg-purple-50 text-purple-700 border-2 border-purple-700 font-semibold py-2 px-4 rounded-lg transition-colors duration-200" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Flight Info
                      <% end %>
                      <%= link_to "View Booking", booking_path(booking), class: "flex-1 inline-flex items-center justify-center bg-purple-700 hover:bg-purple-900 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg" %>
                    </div>

    </div>

  <% end %>
</div>
