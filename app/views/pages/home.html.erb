<!-- Navigation Section -->
<div class="flex justify-between items-center py-6 px-6 bg-purple-50 text-purple-700 font-semibold text-lg">

  <!-- Left: Logo -->
  <div class="flex items-center space-x-2">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
    <span class="text-xl font-bold">Flights</span>
  </div>

  <!-- Center: Navigation -->
  <div class="flex space-x-6">
    <div class="flex items-center space-x-2 hover:text-purple-900 transition">
      <span>Search</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
      </svg>
    </div>

    <div class="flex items-center space-x-2 hover:text-purple-900 transition">
      <span>Book</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
      </svg>
    </div>

    <div class="flex items-center space-x-2 hover:text-purple-900 transition">
      <span>Fly</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 0 1-1.161.886l-.143.048a1.107 1.107 0 0 0-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 0 1-1.652.928l-.679-.906a1.125 1.125 0 0 0-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 0 0-8.862 12.872M12.75 3.031a9 9 0 0 1 6.69 14.036m0 0-.177-.529A2.25 2.25 0 0 0 17.128 15H16.5l-.324-.324a1.453 1.453 0 0 0-2.328.377l-.036.073a1.586 1.586 0 0 1-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 0 1-5.276 3.67m0 0a9 9 0 0 1-10.275-4.835M15.75 9c0 .896-.393 1.7-1.016 2.25" />
      </svg>
    </div>
  </div>

  <!-- Right: User Icon -->
  <div class="hover:text-purple-900 transition">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
    </svg>
  </div>
</div>


<!-- Form Section -->
<div class="mt-16 w-3/4 mx-auto bg-white shadow-lg rounded-xl p-8 border border-purple-100">
  <%= simple_form_for "", url: search_flights_path, method: :get, html: { class: "space-y-6" } do |f| %>

    <!-- Origin and Destination -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%= f.input :origin, placeholder: "From", input_html: { value: params[:origin], class: "w-full rounded-md border-gray-300 focus:ring-purple-500 focus:border-purple-500 shadow-sm" }, label_html: { class: "text-gray-700 font-medium" } %>
      <%= f.input :destination, placeholder: "To", input_html: { value: params[:destination], class: "w-full rounded-md border-gray-300 focus:ring-purple-500 focus:border-purple-500 shadow-sm" }, label_html: { class: "text-gray-700 font-medium" } %>
    </div>

    <!-- Departure and Round Trip -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%= f.input :departure, as: :date, html5: true, input_html: { value: params[:departure], class: "w-full rounded-md border-gray-300 focus:ring-purple-500 focus:border-purple-500 shadow-sm" }, label_html: { class: "text-gray-700 font-medium" } %>
      <%= f.input :round_trip, as: :boolean, label: "Round trip", label_html: { class: "text-gray-700 font-medium" } %>
    </div>

    <!-- Return Date (Initially Hidden) -->
    <div id="return-date-field" class="hidden">
      <%# <%= f.input :return_date, as: :date, html5: true, input_html: { class: "w-full rounded-md border-gray-300 focus:ring-purple-500 focus:border-purple-500 shadow-sm" }, label_html: { class: "text-gray-700 font-medium" } %> %>
    </div>

    <!-- Submit Button -->
    <div>
      <%= f.button :submit, "Search Flights", class: "w-full bg-purple-600 text-white py-3 px-4 rounded-md hover:bg-purple-700 transition duration-300 font-semibold text-lg" %>
    </div>

  <% end %>
</div>

<div>
  <div>
    <h1>Catch flights from:</h1>
  <div>

  <div>

  </div>
</div>
