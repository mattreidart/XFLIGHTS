<%= render "shared/navbar"%>


<h1 class="text-3xl font-bold text-center mt-8 text-gray-800 bg-gray-100 px-3 py-2 rounded">You're almost there! Book now!</h1>

<div class="max-w-2xl mx-auto bg-gray-100 shadow rounded-lg p-6 mt-6">

  <p class="mb-4 text-gray-700">
    Booking flight: <strong><%= @flight.flight_number %></strong>
    from <strong><%= @flight.origin %></strong>
    to <strong><%= @flight.destination %></strong>
  </p>

  <%= simple_form_for [@flight, @booking] do |f| %>

    <!-- Passenger Name (read-only) -->
    <div class="mb-4">
      <label class="block text-gray-700 mb-1">Passenger Name</label>
      <p class="bg-white px-3 py-2 rounded"><%= current_user.name %></p>
    </div>

    <!-- Email (read-only) -->
    <div class="mb-4">
      <label class="block text-gray-700 mb-1">Email</label>
      <p class="bg-white px-3 py-2 rounded"><%= current_user.email %></p>
    </div>

    <div>
      <%= f.button :submit, "Confirm Booking", class: "cursor-pointer w-full bg-purple-600 text-white py-2 rounded hover:bg-purple-700 transition" %>
    </div>

  <% end %>
</div>
