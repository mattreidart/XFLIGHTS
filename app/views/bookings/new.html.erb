<%= render "shared/navbar"%>


<h1 class="text-3xl font-bold text-center mt-8 text-gray-800 bg-gray-100 px-3 py-2 rounded">You're almost there! Book now!</h1>

<div class="max-w-2xl mx-auto bg-gray-100 shadow rounded-lg p-6 mt-6">

  <p class="mb-4 text-gray-700">
    Booking flight: <strong><%= @flight.flight_number %></strong>
    from <strong><%= @flight.origin %></strong>
    to <strong><%= @flight.destination %></strong>
  </p>

  <%= simple_form_for [@flight, @booking] do |f| %>
    <div class="space-y-4">
      <!-- Title -->
      <%= f.input :title, collection: ['Mr', 'Ms', 'Mrs', 'Miss', 'Dr'], prompt: "Select title", label_html: { class: "block text-gray-700 mb-1" }, input_html: { class: "w-full px-3 pr-20 py-2 rounded bg-white" } %>

      <!-- First Name -->
      <%= f.input :first_name, label_html: { class: "block text-gray-700 mb-1" }, input_html: { class: "w-full px-3 py-2 bg-white" } %>

      <!-- Middle Name -->
      <%= f.input :middle_name, label_html: { class: "block text-gray-700 mb-1" }, input_html: { class: "w-full px-3 py-2 bg-white" } %>

      <!-- Last Name -->
      <%= f.input :last_name, label_html: { class: "block text-gray-700 mb-1" }, input_html: { class: "w-full px-3 py-2 bg-white" } %>

      <!-- Phone Number-->
      <%= f.input :phone_number, label_html: { class: "block text-gray-700 mb-1" }, input_html: { class: "w-full px-3 py-2 bg-white" } %>

      <!-- Gender -->
      <%= f.input :gender, collection: ['Male', 'Female', 'Other'], prompt: "Select gender", label_html: { class: "block text-gray-700 mb-1" } %>

      <!-- Date of Birth -->
      <%= f.input :date_of_birth, as: :date, start_year: 1900, end_year: Date.today.year, order: [:day, :month, :year], label_html: { class: "block text_gray-700" }, input_html: { class: "w-full px-3 py-2 rounded bg-white"} %>
  </div>


    <div>
      <%= f.button :submit, "Confirm Booking", class: "cursor-pointer w-full bg-purple-600 text-white py-2 rounded hover:bg-purple-700 transition" %>
    </div>

  <% end %>
</div>
