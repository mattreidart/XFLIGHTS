<%= render "shared/navbar" %>

<div class="min-h-screen bg-gradient-to-b from-purple-50 to-white py-12">
  <div class="w-11/12 md:w-3/4 mx-auto max-w-6xl">
    <!-- Welcome Header -->
    <div class="mb-8">
      <h2 class="text-4xl text-purple-700 font-bold text-center bg-purple-100 px-6 py-4 rounded-lg shadow-sm">
        <% if @user.first_name.present? %>
          Welcome back, <%= @user.first_name %>!
        <% else %>
          Welcome back!
        <% end %>
      </h2>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-xl p-8 hover:shadow-2xl transition-shadow duration-300">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- User Details Section -->
        <div class="lg:w-1/3 space-y-6 lg:sticky lg:top-25 lg:self-start">
          <h2 class="text-2xl font-bold text-purple-700 border-b-2 border-purple-200 pb-2 mb-4">
            Your Details
          </h2>

          <div class="space-y-4">
            <div class="bg-purple-50 p-4 rounded-lg">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Full Name</p>
              <p class="text-lg font-medium text-gray-800">
                <%= @user.title %> <%= @user.first_name %> <%= @user.last_name %>
              </p>
            </div>

            <div class="bg-purple-50 p-4 rounded-lg">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Gender</p>
              <p class="text-lg font-medium text-gray-800">
                <%= @user.gender %>
              </p>
            </div>

            <div class="bg-purple-50 p-4 rounded-lg">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Mobile</p>
              <p class="text-lg font-medium text-gray-800">
                <%= @user.phone_number %>
              </p>
            </div>

            <div class="bg-purple-50 p-4 rounded-lg">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
              <p class="text-lg font-medium text-gray-800 break-words">
                <%= @user.email %>
              </p>
            </div>

            <div class="bg-purple-50 p-4 rounded-lg">
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Date Of Birth</p>
              <p class="text-lg font-medium text-gray-800">
                <%= @user.date_of_birth.strftime('%a %b %d, %Y') %>
              </p>
            </div>

            <!-- Link to edit user profile -->
            <div class="pt-2">
              <%= link_to edit_user_registration_path, class: "inline-flex items-center justify-center w-full bg-purple-700 hover:bg-purple-800 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Update Info
              <% end %>
            </div>
          </div>
        </div>

        <!-- Upcoming Bookings Section -->
        <div class="lg:w-2/3 space-y-6">
          <h2 class="text-2xl font-bold text-purple-700 border-b-2 border-purple-200 pb-2 mb-4">
            Upcoming Bookings
          </h2>

          <% if @all_bookings.empty? %>
            <!-- No Bookings -->
            <div class="bg-gradient-to-r from-purple-50 to-purple-100 shadow-md rounded-lg p-8 flex flex-col items-center justify-center space-y-6 text-center hover:shadow-xl transition-shadow duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-purple-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
              </svg>
              <div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">No bookings yet!</h3>
                <p class="text-gray-600">Start planning your next adventure</p>
              </div>
              <%= link_to "Book your next adventure here", root_path, class: "inline-flex items-center text-white bg-purple-700 hover:bg-purple-900 px-6 py-3 rounded-lg text-sm font-semibold transition-colors duration-200 shadow-md hover:shadow-lg" %>
            </div>
          <% else %>
            <!-- Bookings List -->
            <div class="space-y-6">
              <% @user.bookings.each do |booking| %>
                <div class="bg-gradient-to-br from-white to-purple-50 shadow-md rounded-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-purple-100">

                  <!-- Airline Header -->
                  <div class="bg-purple-700 text-white px-6 py-3 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                      </svg>
                      <div>
                        <p class="font-bold text-lg"><%= booking.flight.airline.name %></p>
                        <p class="text-sm text-purple-200">Flight <%= booking.flight.flight_number %></p>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-2xl font-bold">$<%= booking.flight.price %></p>
                    </div>
                  </div>

                  <div class="p-6 space-y-4">
                    <!-- Airline Logo -->
                    <div class="flex justify-center bg-white p-4 rounded-lg border border-purple-100">
                      <img class="h-20 w-auto object-contain" src="<%= booking.flight.airline.logo %>" alt="<%= booking.flight.airline.name %> Logo">
                    </div>

                    <!-- Route -->
                    <div class="flex items-center justify-between bg-gradient-to-r from-purple-100 to-purple-50 p-6 rounded-lg">
                      <div class="text-center flex-1">
                        <p class="text-3xl font-bold text-purple-700"><%= booking.flight.origin %></p>
                        <p class="text-xs text-gray-600 mt-1 uppercase tracking-wide">Origin</p>
                      </div>

                      <div class="mx-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                        </svg>
                      </div>

                      <div class="text-center flex-1">
                        <p class="text-3xl font-bold text-purple-700"><%= booking.flight.destination %></p>
                        <p class="text-xs text-gray-600 mt-1 uppercase tracking-wide">Destination</p>
                      </div>
                    </div>

                    <!-- Departure & Arrival Info -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div class="bg-white p-4 rounded-lg border border-purple-100">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 flex items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                          </svg>
                          Departure
                        </p>
                        <p class="text-lg font-bold text-gray-800"><%= booking.flight.origin %></p>
                        <p class="text-2xl font-bold text-purple-700"><%= booking.flight.departure.strftime("%l:%M %p") %></p>
                        <p class="text-sm text-gray-600"><%= booking.flight.departure.strftime("%A, %B %d, %Y") %></p>
                      </div>

                      <div class="bg-white p-4 rounded-lg border border-purple-100">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 flex items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                          </svg>
                          Arrival
                        </p>
                        <p class="text-lg font-bold text-gray-800"><%= booking.flight.destination %></p>
                        <p class="text-2xl font-bold text-purple-700"><%= booking.flight.arrival.strftime("%l:%M %p") %></p>
                        <p class="text-sm text-gray-600"><%= booking.flight.arrival.strftime("%A, %B %d, %Y") %></p>
                      </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-3 pt-2">
                      <%= link_to flight_path, class: "flex-1 inline-flex items-center justify-center bg-white hover:bg-purple-50 text-purple-700 border-2 border-purple-700 font-semibold py-2 px-4 rounded-lg transition-colors duration-200" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Flight Info
                      <% end %>
                      <%= link_to "View Booking", booking_path(booking), class: "flex-1 inline-flex items-center justify-center bg-purple-700 hover:bg-purple-900 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
