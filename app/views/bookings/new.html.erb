<%= render "shared/navbar"%>

<div class="text-center mb-8">
  <h1 class="text-5xl font-bold text-purple-700 mb-3">You're almost there!</h1>
  <p class="text-gray-600 text-lg">We just need a little more info to make your booking</p>
</div>

<div class="w-11/12 md:w-3/4 mx-auto max-w-5xl">
  <div class="bg-white shadow-2xl rounded-2xl p-8 border border-purple-100">
    <div class="text-center mb-4">
      <p class="mb-4 text-gray-700">
        Booking flight: <strong><%= @flight.flight_number %></strong>
        from <strong><%= @flight.origin %></strong>
        to <strong><%= @flight.destination %></strong>
      </p>
    </div>
    <%= simple_form_for [@flight, @booking] do |f| %>
      <div class="flex">
        <!-- Title -->
        <div class="w-1/2 mr-2">
          <%= f.input :title, collection: ['Mr', 'Ms', 'Mrs', 'Miss', 'Dr'], prompt: "Select title", label_html: { class: "text-gray-700 font-semibold mb-2 block"  }, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
        <!-- Gender -->
        <div class="w-1/2 ml-2">
          <%= f.input :gender, collection: ['Male', 'Female', 'Other'], prompt: "Select title", label_html: { class: "text-gray-700 font-semibold mb-2 block"  }, input_html: { class: "w-full px-2 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
      </div>
      <div class="flex">
        <!-- First Name -->
        <div class="w-1/2 mr-2 ">
          <%= f.input :first_name, label_html:  { class: "text-gray-700 font-semibold mb-2 block" }, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
        <!-- Middle Name -->
        <div class="w-1/2 ml-2">
          <%= f.input :middle_name, label_html:  { class: "text-gray-700 font-semibold mb-2 block" }, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
      </div>
      <div class="flex">
        <!-- Last Name -->
        <div class="w-1/2 mr-2">
          <%= f.input :last_name, label_html:  { class: "text-gray-700 font-semibold mb-2 block" }, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
        <div class="w-1/2 ml-2">
          <%= f.input :phone_number, label_html:  { class: "text-gray-700 font-semibold mb-2 block" }, input_html: { class: "w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition" } %>
        </div>
      </div>
        <div>
          <!-- Date of Birth -->
          <%= f.input :date_of_birth, as: :date, start_year: 1900, end_year: Date.today.year, order: [:day, :month, :year], label_html: { class: "block text_gray-700" }, input_html: { class: "w-full px-3 py-2 rounded bg-white"} %>
        </div>
      <div>
      </div>
      <div>
      <%= f.button :submit, "Confirm Booking", class: "w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white py-4 px-6 rounded-lg hover:from-purple-700 hover:to-purple-800 transition duration-300 font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
    </div>
    <% end %>
  </div>
</div>
