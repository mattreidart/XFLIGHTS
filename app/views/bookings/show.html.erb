<%= render "shared/navbar" %>

<div class="min-h-screen bg-gradient-to-b from-purple-50 to-white py-12">
  <div class="w-11/12 md:w-3/4 mx-auto max-w-5xl">

    <!-- Header -->
    <div class="mb-8">
      <h2 class="text-4xl text-purple-700 font-bold text-center bg-purple-100 px-6 py-4 rounded-lg shadow-sm">
        Booking Confirmation
      </h2>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-xl p-8 hover:shadow-2xl transition-shadow duration-300">

      <div class="flex">

        <!-- Passenger Details Section -->
        <div class="w-1/3 mr-2">
          <h2 class="text-2xl font-bold text-purple-700 border-b-2 border-purple-200 pb-2 mb-4">
            Passenger
          </h2>

          <div class="space-y-4">
            <div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-20 text-purple-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
              </svg>
            </div>

            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Full Name</p>
              <p class="text-lg font-medium text-gray-800 mt-1">
                <%= @booking.title %> <%= @booking.first_name %> <%= @booking.last_name %>
              </p>
            </div>

            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Gender</p>
              <p class="text-lg font-medium text-gray-800 mt-1">
                <%= @booking.gender %>
              </p>
            </div>

            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Mobile</p>
              <p class="text-lg font-medium text-gray-800 mt-1">
                <%= @booking.phone_number %>
              </p>
            </div>
          </div>
        </div>

        <!-- Flight Info Section -->
        <div class="w-2/3 ml-2">
          <h2 class="text-2xl font-bold text-purple-700 border-b-2 border-purple-200 pb-2 mb-4">
            Flight Information
          </h2>

          <!-- Airline Info -->
          <div class="flex justify-between bg-purple-50 p-4 rounded-lg">
            <img class="h-20 w-32 object-contain rounded" src="<%= @booking.flight.airline.logo %>" alt="<%= @booking.flight.airline.name %> Logo">
            <div class="mt-4 flex flex-col items-center">
              <p class="text-lg font-bold text-gray-800"><%= @booking.flight.airline.name %></p>
              <p class="text-sm text-gray-600">Flight <%= @booking.flight.flight_number %></p>
            </div>
            <div class="mt-4 flex flex-col items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
              </svg>
              <%= link_to "Flight Info",  flight_path, class: "underline" %>
            </div>
          </div>

          <!-- Route -->
          <div class="flex items-center justify-between bg-gradient-to-r from-purple-100 to-purple-50 p-4 rounded-lg">
            <div class="text-center">
              <p class="text-2xl font-bold text-purple-700"><%= @booking.flight.origin %></p>
              <p class="text-xs text-gray-600 mt-1">Origin</p>
            </div>

            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
            </svg>

            <div class="text-center">
              <p class="text-2xl font-bold text-purple-700"><%= @booking.flight.destination %></p>
              <p class="text-xs text-gray-600 mt-1">Destination</p>
            </div>
          </div>

          <!-- Departure Info -->
          <div class="flex justify-between">
            <div class="space-y-1">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Departure</p>
              <p class="text-base font-medium text-gray-800"><%= @booking.flight.origin %></p>
              <p class="text-sm text-gray-600"><%= @booking.flight.departure.strftime("%l:%M %p %Z") %></p>
              <p class="text-sm text-gray-600"><%= @booking.flight.departure.strftime("%A, %B %d, %Y") %></p>
            </div>

            <!-- Arrival Info -->
            <div class="space-y-1">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Arrival</p>
              <p class="text-base font-medium text-gray-800"><%= @booking.flight.destination %></p>
              <p class="text-sm text-gray-600"><%= @booking.flight.arrival.strftime("%l:%M %p %Z") %></p>
              <p class="text-sm text-gray-600"><%= @booking.flight.arrival.strftime("%A, %B %d, %Y") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
